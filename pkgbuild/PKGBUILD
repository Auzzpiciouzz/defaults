pkgname=defaults
pkgver=0.1.0
pkgrel=1
pkgdesc='Choose which app opens each kind of file on Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'shared-mime-info')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/defaults "$pkgdir/usr/bin/defaults"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/defaults.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/defaults.svg"
  install -Dm644 "$startdir/defaults.desktop" "$pkgdir/usr/share/applications/defaults.desktop"
}
